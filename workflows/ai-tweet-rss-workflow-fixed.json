      "parameters": {
        "functionCode": "// ツイート投稿ログ\nconst items = $input.all();\nconst timestamp = new Date().toISOString();\n\nconst logData = {\n  timestamp: timestamp,\n  totalProcessed: items.length,\n  successful: items.filter(item => item.json.success !== false).length,\n  failed: items.filter(item => item.json.success === false).length,\n  tweets: items.map(item => ({\n    title: item.json.title,\n    category: item.json.category,\n    success: item.json.success !== false,\n    tweetLength: item.json.tweet ? item.json.tweet.length : 0\n  }))\n};\n\nconsole.log('AI Tweet Bot Execution Log:', JSON.stringify(logData, null, 2));\n\nreturn [{ json: logData }];"
