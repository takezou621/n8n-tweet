    {
      "parameters": {
        "functionCode": "// RSS XMLをJSONに変換する関数\nfunction parseRSSXML(xmlString) {\n  try {\n    // 簡易的なXMLパーサー\n    const items = [];\n    const itemMatches = xmlString.match(/<item[^>]*>([\\s\\S]*?)<\\/item>/g);\n    \n    if (!itemMatches) return [];\n    \n    for (const itemMatch of itemMatches.slice(0, 3)) { // 最新3件のみ\n      const titleMatch = itemMatch.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/);\n      const linkMatch = itemMatch.match(/<link[^>]*>([\\s\\S]*?)<\\/link>/);\n      const descriptionMatch = itemMatch.match(/<description[^>]*>([\\s\\S]*?)<\\/description>/);\n      const pubDateMatch = itemMatch.match(/<pubDate[^>]*>([\\s\\S]*?)<\\/pubDate>/);\n      \n      if (titleMatch && linkMatch) {\n        items.push({\n          title: titleMatch[1].replace(/<!\\[CDATA\\[(.*)\\]\\]>/, '$1').replace(/<[^>]*>/g, '').trim(),\n          link: linkMatch[1].replace(/<!\\[CDATA\\[(.*)\\]\\]>/, '$1').replace(/<[^>]*>/g, '').trim(),\n          description: descriptionMatch ? descriptionMatch[1].replace(/<!\\[CDATA\\[(.*)\\]\\]>/, '$1').replace(/<[^>]*>/g, '').trim() : '',\n          pubDate: pubDateMatch ? pubDateMatch[1].replace(/<!\\[CDATA\\[(.*)\\]\\]>/, '$1').replace(/<[^>]*>/g, '').trim() : ''\n        });\n      }\n    }\n    \n    return items;\n  } catch (error) {\n    console.error('RSS parsing error:', error);\n    return [];\n  }\n}\n\n// AI関連キーワード\nconst aiKeywords = [\n  'artificial intelligence', 'machine learning', 'deep learning',\n  'neural network', 'transformer', 'gpt', 'llm', 'chatgpt',\n  'computer vision', 'natural language processing', 'nlp',\n  'reinforcement learning', 'supervised learning', 'unsupervised learning',\n  'algorithm', 'model', 'dataset', 'training', 'inference',\n  'openai', 'anthropic', 'claude', 'tensorflow', 'pytorch',\n  'generative ai', 'diffusion model', 'stable diffusion',\n  'ai safety', 'alignment', 'ethics', 'bias'\n];\n\n// コンテンツフィルタリング\nfunction isAIRelated(text) {\n  if (!text) return false;\n  const lowerText = text.toLowerCase();\n  return aiKeywords.some(keyword => lowerText.includes(keyword));\n}\n\n// ツイート生成\nfunction generateTweet(item, feedInfo) {\n  const maxLength = feedInfo.maxLength || 240;\n  const hashtags = feedInfo.hashtags || ['#AI'];\n  \n  let content = item.title;\n  if (content.length > maxLength - 50) {\n    content = content.substring(0, maxLength - 50) + '...';\n  }\n  \n  const tweet = `${content} ${hashtags.join(' ')}`;\n  return tweet;\n}\n\n// メイン処理\nconst xmlData = $input.first().json.body || $input.first().json;\nconst items = parseRSSXML(xmlData);\nconst feedInfo = $node[\"RSS Feed Config\"].json.categories[$input.first().json.category] || {};\n\nconst results = [];\nfor (const item of items) {\n  if (isAIRelated(item.title + ' ' + item.description)) {\n    const tweet = generateTweet(item, feedInfo);\n    results.push({\n      json: {\n        ...item,\n        tweet: tweet,\n        category: $input.first().json.category || 'unknown',\n        success: true\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "name": "Parse RSS and Filter Content",
      "type": "@n8n/n8n-nodes-base.function",
